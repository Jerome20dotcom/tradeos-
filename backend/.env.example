# Copy this file to .env and fill it in. Never commit .env.
ENVIRONMENT=development
PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=the-password-you-set-when-installing-postgresql
PG_APP_USER=tradeos_app
PG_APP_PASSWORD=choose-a-different-password-for-the-app-role
DB_NAME=tradeos
TEST_DB_NAME=tradeos_test
# At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Required for public email/password registration, email verification, and password reset.
PUBLIC_BASE_URL=https://your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=TradeOS <no-reply@your-domain.example>
# Optional hosted Copilot provider (OpenAI-compatible Chat Completions API).
COPILOT_API_KEY=
COPILOT_BASE_URL=https://api.openai.com/v1
COPILOT_MODEL=gpt-4o-mini
